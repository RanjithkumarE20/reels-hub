# Copy to .env (optional - everything works without it)

# Server
PORT=4321
# 0.0.0.0 lets your phone on the same Wi-Fi open http://<this-PC-IP>:4321
HOST=127.0.0.1

# Quote reels: how often new ones are made automatically, and how many each time
QUOTE_INTERVAL_MIN=15
QUOTES_PER_RUN=5
# Song language mix (weights). ta = Tamil, hi = Hindi, en = English
SONG_MIX=ta:2,hi:1,en:1

# News: refresh interval, Google Trends regions, YouTube news channels (@handles)
NEWS_INTERVAL_MIN=10
TRENDS_GEO=IN,IN-TN
YT_CHANNELS=ThanthiTV,SunNewsTamil,PolimerNews,PuthiyathalaimuraiTV,NDTV,IndiaToday,aajtak,BBCNewsTamil

# Optional AI song picks (free key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ---------------- Instagram auto-posting (see INSTAGRAM.md) ----------------
# Turn the scheduler on, and keep DRY_RUN=true until the test files look right
IG_ENABLED=false
IG_DRY_RUN=true
# From the Meta app dashboard (Instagram > API setup with Instagram login > Generate token)
IG_ACCESS_TOKEN=
IG_USER_ID=
# Optional: app secret, only needed to convert a 1-hour token into a 60-day token
IG_APP_SECRET=
# Shown on the videos/cards, e.g. @tamil.quotes.daily
IG_HANDLE=

# Posting times (24 h, this PC's clock)
IG_REEL_TIMES=10:30,14:00,20:30
IG_STORY_TIMES=12:00,16:30,22:00
IG_NEWS_STORY_TIMES=09:30,13:00,17:15,21:15
# Never render/upload in these windows: they are the YouTube Shorts tasks (08:00 and 18:00)
IG_QUIET=07:45-09:15,17:45-19:15
IG_MAX_PER_DAY=12

# Music on uploaded videos: auto (real tracks from music/<mood>/ when present, else generated) | folder | generated | none
IG_MUSIC=auto
IG_MUSIC_DIR=music
IG_REEL_SECONDS=20
IG_STORY_SECONDS=15
IG_NEWS_LANGS=ta,en,hi
IG_HASHTAGS=#englishquotes #tamilvibes #quoteoftheday
IG_MAX_HASHTAGS=5

# Public link for Instagram to download files: by default a temporary Cloudflare quick tunnel
# (needs: winget install --id Cloudflare.cloudflared). Or your own permanent URL to port IG_MEDIA_PORT:
IG_MEDIA_PORT=4322
IG_PUBLIC_BASE_URL=
